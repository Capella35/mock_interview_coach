# Copy to .env (gitignored) and fill in. Never commit real keys.

# Primary LLM provider (dev): Groq — used for extraction and matching
GROQ_API_KEY=
# Which Groq model to use (chosen before the first real run from Groq's current model list)
LLM_MODEL=
# Provider switch: groq (default). "anthropic" is reserved for the optional second provider (not wired yet)
# LLM_PROVIDER=groq
# Never set GROQ_LOG=debug — the SDK would log request bodies (document text); the app refuses to start with it

# Optional second LLM provider — not used yet
# ANTHROPIC_API_KEY=

# Voice speech-to-text — later milestone, provider not decided
# STT_API_KEY=
# Voice text-to-speech — later milestone, provider not decided
# TTS_API_KEY=
